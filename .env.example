# Harness OS works with code-owned demo/runtime URLs by default.
# Keep environment configuration minimal: secrets + optional overrides only.

# Optional mode override. Demo remains the safe local default.
HARNESS_OS_MODE=demo

# TrueForge hosted URL defaults in code to https://harsha.truefoundry.cloud.
# Set ONLY if TrueForge exposes a different API origin.
# TRUEFORGE_API_BASE_URL=https://your-trueforge-api.example
# TRUEFORGE_BASE_URL=https://your-trueforge-api.example

# Secret: keep server-side only. Leave blank only if the hosted TrueForge API does not require auth.
TRUEFORGE_TOKEN=

# Optional runtime tuning.
# TRUEFORGE_REQUEST_TIMEOUT_SECONDS=60
# TRUEFORGE_PROBE_TIMEOUT_SECONDS=4
# TRUEFORGE_EVENT_POLL_SECONDS=1

# Optional public frontend CORS origin when deploying the control plane.
# HARNESS_OS_CORS_ORIGINS=https://your-ui.example

# Optional GitHub API token for higher unauthenticated rate limits / Qodo evidence lookup.
GITHUB_TOKEN=

# Optional production database override.
DATABASE_URL=

# Code-owned project defaults:
# TrueForge host: https://harsha.truefoundry.cloud
# TrueForge agent: harness-os
# Repository: https://github.com/harshapriyag123/harness-os
# Refund fixture: https://harness-os.onrender.com
# Refund health: https://harness-os.onrender.com/health
# FaultLine MCP: https://faultline-h005.onrender.com/mcp
# FaultLine health: https://faultline-h005.onrender.com/health
# Qodo repository: harshapriyag123/harness-os
