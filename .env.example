# Harness OS execution mode. Use live for judge-facing runs.
HARNESS_OS_MODE=demo
HARNESS_OS_DB=backend/harness_os.db
HARNESS_OS_CORS_ORIGINS=http://localhost:5173

# TrueForge runtime.
# IMPORTANT: in HARNESS_OS_MODE=live, localhost fallback is intentionally disabled.
# Set the public TrueForge API origin here (the host that exposes /api/v1/capabilities
# and /api/v1/sessions), NOT the human-facing dashboard URL.
# TRUEFORGE_API_BASE_URL is the preferred hosted name; TRUEFORGE_BASE_URL remains supported.
TRUEFORGE_API_BASE_URL=
TRUEFORGE_BASE_URL=
TRUEFORGE_TOKEN=
TRUEFORGE_AGENT_NAME=harness-os
TRUEFORGE_MODEL_PROVIDER=google-gemini
TRUEFORGE_MODEL=
TRUEFORGE_REQUEST_TIMEOUT_SECONDS=60
# Mission Control uses a short non-mutating capability probe so a sleeping/misconfigured
# hosted runtime does not freeze the whole UI. It can be retried interactively.
TRUEFORGE_PROBE_TIMEOUT_SECONDS=4
TRUEFORGE_EVENT_POLL_SECONDS=1

# Model secrets/providers are configured in TrueForge itself. Keep secrets blank in source control.
OPENAI_API_KEY=

# GitHub MCP / remediation. Prefer the connector configured inside TrueForge.
GITHUB_TOKEN=
GITHUB_TARGET_REPOSITORY=harshapriyag123/harness-os
GITHUB_DEFAULT_BRANCH=main
GITHUB_REMEDIATION_BRANCH_PREFIX=harness-os/remediation

# FaultLine / Harness Chaos MCP.
HARNESS_CHAOS_MCP_URL=https://faultline-h005.onrender.com/mcp
HARNESS_CHAOS_MCP_NAME=faultline

# Public hosted services bridged into the local UI.
PUBLIC_REFUND_FIXTURE_URL=https://harness-os.onrender.com/health
PUBLIC_FAULTLINE_HEALTH_URL=https://faultline-h005.onrender.com/health

# Qodo evidence source. Campaign-specific PRs override this when certification is active.
QODO_REPOSITORY=harshapriyag123/harness-os
QODO_PR_NUMBER=14

# Deterministic vulnerable customer-support fixture.
FIXTURE_BASE_URL=https://harness-os.onrender.com
FIXTURE_DB=backend/customer_fixture.db
FIXTURE_ORDER_ID=ORD-1042
FIXTURE_REFUND_CENTS=24900

# Optional production database override.
DATABASE_URL=
