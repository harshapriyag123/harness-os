# Harness OS works with code-owned demo/runtime URLs by default.
# Keep environment configuration minimal: secrets + optional overrides only.

HARNESS_OS_MODE=demo

# Harness OS -> TrueForge API origin.
# TRUEFORGE_API_BASE_URL=https://harness-os-trueforge.onrender.com
TRUEFORGE_TOKEN=

# Hosted TrueForge bootstrap. The Render blueprint provides all non-secret defaults.
# Set TRUEFORGE_MODEL_API_KEY only in the Render secret environment for harness-os-trueforge.
TRUEFORGE_BOOTSTRAP_ENABLED=true
TRUEFORGE_AGENT_NAME=harness-os
TRUEFORGE_MODEL_PROVIDER=openai
TRUEFORGE_MODEL_ID=gpt-5-4-mini
TRUEFORGE_MODEL_NAME=gpt-5-4-mini
TRUEFORGE_MODEL_API_KEY=
TRUEFORGE_FAULTLINE_MCP_NAME=faultline
TRUEFORGE_FAULTLINE_MCP_URL=https://faultline-h005.onrender.com/mcp
# TRUEFORGE_BOOTSTRAP_WAIT_MS=300000

# Optional runtime tuning.
# TRUEFORGE_REQUEST_TIMEOUT_SECONDS=60
# TRUEFORGE_PROBE_TIMEOUT_SECONDS=4
# TRUEFORGE_EVENT_POLL_SECONDS=1

# Optional public frontend CORS origin when deploying the control plane.
# HARNESS_OS_CORS_ORIGINS=https://your-ui.example

# Optional GitHub API token for higher unauthenticated rate limits / Qodo evidence lookup.
# Do not place a GitHub write token in the public hosted TrueForge demo while OIDC is disabled.
GITHUB_TOKEN=

# Optional production database override.
DATABASE_URL=

# Project endpoints:
# TrueForge: https://harness-os-trueforge.onrender.com
# Repository: https://github.com/harshapriyag123/harness-os
# Refund fixture: https://harness-os.onrender.com
# FaultLine MCP: https://faultline-h005.onrender.com/mcp
# FaultLine health: https://faultline-h005.onrender.com/health
